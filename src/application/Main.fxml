<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<AnchorPane prefHeight="249.0" prefWidth="230.0"
	xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="application.CalculatorController"
	stylesheets="@style.css">

	<children>
		<TextField fx:id="displayField"
			text="0"
			editable="false"
			layoutX="3.0"
			layoutY="25"
			prefHeight="38.0"
			prefWidth="226.0"
			styleClass="text-field" />

		<!-- Row 1 -->
		<Button text="7"
			layoutX="14.0" layoutY="72.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleNumber" />

		<Button text="8"
			layoutX="66.0" layoutY="72.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleNumber" />

		<Button text="9"
			layoutX="117.0" layoutY="72.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleNumber"
			styleClass="number-button" />

		<Button text="/"
			layoutX="172.0" layoutY="72.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleOperator"
			styleClass="operator-button"
		/>

		<!-- Row 2 -->
		<Button text="4"
			layoutX="14.0" layoutY="111.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleNumber"
			styleClass="number-button" />

		<Button text="5"
			layoutX="66.0" layoutY="111.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleNumber"
			styleClass="number-button" />

		<Button text="6"
			layoutX="117.0" layoutY="111.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleNumber"
			styleClass="number-button" />

		<Button text="*"
			layoutX="172.0" layoutY="111.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleOperator"
			styleClass="operator-button"
		/>

		<!-- Row 3 -->
		<Button text="1"
			layoutX="14.0" layoutY="154.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleNumber"
			styleClass="number-button" />

		<Button text="2"
			layoutX="66.0" layoutY="154.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleNumber" />

		<Button text="3"
			layoutX="117.0" layoutY="154.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleNumber"
			styleClass="number-button" />

		<Button text="-"
			layoutX="172.0" layoutY="154.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleOperator"
			styleClass="operator-button"
		/>

		<!-- Row 4 -->
		<Button text="C"
			layoutX="14.0" layoutY="195.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleClear"
			styleClass="clear-button" />

		<Button text="0"
			layoutX="66.0" layoutY="195.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleNumber"
			styleClass="number-button"
		/>

		<Button text="="
			layoutX="117.0" layoutY="195.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleEqual"
			styleClass="equal-button"
		/>

		<Button text="+"
			layoutX="172.0" layoutY="195.0"
			prefHeight="26.0" prefWidth="38.0"
			onAction="#handleOperator"
			styleClass="operator-button" />

	</children>

</AnchorPane>